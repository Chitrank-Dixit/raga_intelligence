# Environment Configuration for Indian Raga Intelligence
ENV=development
LOG_LEVEL=INFO
DEBUG=false

# Compute / Hardware
DEVICE=auto # auto, cuda, or cpu
CUDA_VISIBLE_DEVICES=0
NUM_WORKERS=4

# Paths
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
CONFIGS_DIR=./configs
MODELS_CACHE_DIR=./artifacts/models

# MERT Pretrained Model
MERT_MODEL_NAME=m-a-p/MERT-v1-95M
MERT_SAMPLE_RATE=24000
SEGMENT_DURATION_SEC=5.0

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
MAX_UPLOAD_SIZE_MB=50
MAX_AUDIO_DURATION_SEC=600

